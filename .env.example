# Copie para .env.local (no seu PC) ou cadastre em Vercel > Settings > Environment Variables.
# Sem estas duas variáveis o site abre em MODO DEMONSTRAÇÃO, com dados de exemplo.
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chave anon (pública)>
# Endereço do site, usado no link de acesso enviado por e-mail
NEXT_PUBLIC_SITE_URL=https://portal.exemplo.com.br
# A chave service_role NUNCA vai aqui. Ela fica só na máquina de operação dos agentes.
